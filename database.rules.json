{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('b2b_access').child($uid).exists()",

        "email": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 254 && (newData.val() === '' || (newData.val().matches(/^[^ @]+@[^ @]+[.][^ @]+$/) && !newData.val().contains(\"\\t\") && !newData.val().contains(\"\\r\") && !newData.val().contains(\"\\n\") && !newData.val().contains(\"\\f\") && !newData.val().contains(\"\\u000b\") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\"\\u2028\") && !newData.val().contains(\"\\u2029\") && !newData.val().contains(\" \") && !newData.val().contains(\" \") && !newData.val().contains(\"　\") && !newData.val().contains(\"﻿\")))"
        },
        "displayName": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "createdAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || data.val() === newData.val())"
        },
        "lastLogin": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },

        "reports": {
          "$sid": {
            ".write": "auth != null && auth.uid === $uid && root.child('payments').child($uid).child('paid').val() === true && root.child('b2b_access').child($uid).child('surveySid').val() !== $sid && root.child('responses').child($uid).child($sid).child('meta/source').val() !== 'b2b' && root.child('reports').child($uid).child($sid).child('report/_participation/source').val() !== 'b2b'",
            "sid": {
              ".validate": "newData.isString() && newData.val().length <= 80 && (!data.exists() || data.val() === newData.val())"
            },
            "generatedAt": {
              ".validate": "(newData.isNumber() || (newData.isString() && newData.val().length <= 40)) && (!data.exists() || data.val() === newData.val())"
            },
            "toneKey": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
            },
            "signatureShort": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200)"
            },
            "name": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
            },
            "submittedAt": {
              ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
            },
            "lang": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 8)"
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false },

        "programs": {
          ".write": "auth != null && auth.uid === $uid",
          "$sid": {
            "sid": {
              ".validate": "newData.isString() && newData.val().length <= 80 && (!data.exists() || data.val() === newData.val())"
            },
            "sourceSid": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80 && (!data.exists() || data.val() === newData.val()))"
            },
            "generatedAt": {
              ".validate": "(newData.isNumber() || (newData.isString() && newData.val().length <= 40)) && (!data.exists() || data.val() === newData.val())"
            },
            "toneKey": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
            },
            "name": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
            },
            "lang": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 8)"
            },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "b2b_access": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "payments": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('b2b_access').child($uid).exists() && (!data.exists() || data.child('paid').val() !== true)",

        ".validate": "newData.hasChildren(['paid', 'createdAt']) || newData.hasChild('_pending')",

        "paid": {
          ".validate": "newData.isBoolean() && newData.val() === true"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length <= 40 && (!data.exists() || data.val() === newData.val())"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "provider": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "env": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "orderID": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "captureID": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "amount": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "currency": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "_pending": {
          ".validate": "newData.val() === null || newData.hasChildren(['provider'])",
          "provider":  { ".validate": "newData.isString() && newData.val().length <= 40" },
          "env":       { ".validate": "newData.isString() && newData.val().length <= 20" },
          "orderID":   { ".validate": "newData.isString() && newData.val().length <= 80" },
          "amount":    { ".validate": "newData.isString() && newData.val().length <= 20" },
          "currency":  { ".validate": "newData.isString() && newData.val().length <= 10" },
          "createdAt": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)" },
          "$other":    { ".validate": false }
        },

        "$other": {
          ".validate": false
        }
      }
    },

    "additionalPayments": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": false,
        "$token": {
          ".validate": "newData.hasChildren(['status', 'createdAt']) || data.exists()",
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'unused' || newData.val() === 'consumed')"
          },
          "provider": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "env": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "orderID": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "captureID": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "amount": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "currency": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "createdAt": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "consumedAt": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "consumedSid": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "intentTs": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "responses": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('b2b_access').child($uid).exists()",

        "_active": {
          ".write": "auth != null && auth.uid === $uid && root.child('payments').child($uid).child('paid').val() === true",
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
        },

        "$sid": {
          ".write": "auth != null && auth.uid === $uid && ((root.child('b2b_access').child($uid).child('surveySid').val() === $sid && data.exists() && newData.exists() && data.child('status').val() === 'in_progress' && !root.child('b2b_access').child($uid).child('reportSid').exists() && newData.child('meta/source').val() === 'b2b' && newData.child('meta/b2bOrderId').val() === root.child('b2b_access').child($uid).child('orderId').val() && (newData.child('status').val() === 'in_progress' || newData.child('status').val() === 'submitted')) || (root.child('payments').child($uid).child('paid').val() === true && root.child('b2b_access').child($uid).child('surveySid').val() !== $sid && data.child('meta/source').val() !== 'b2b' && newData.child('meta/source').val() !== 'b2b'))",
          ".validate": "newData.hasChildren(['status'])",

          "status": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "submittedAt": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "startedAt": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "name": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
          },
          "email": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 254)"
          },
          "recvMethod": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 254)"
          },
          "userAgent": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 512)"
          },
          "lang": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 8)"
          },
          "meta": {
            "recoveryDismissed": {
              ".write": "auth != null && auth.uid === $uid && root.child('responses').child($uid).child($sid).exists() && (root.child('responses').child($uid).child($sid).child('status').val() === 'submitted' || root.child('responses').child($uid).child($sid).child('status').val() === 'completed') && newData.isBoolean()",
              ".validate": "newData.isBoolean()"
            },
            "step": {
              ".validate": "newData.isNumber()"
            },
            "answered": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()"
            }
          },
          "answers": {
            "$qid": {
              ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren() || newData.val() === null"
            }
          },
          "qlog": {
            "$qid": {
              "d": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000" },
              "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999" },
              "t": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "reports": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('b2b_access').child($uid).exists()",

        "$sid": {
          ".write": "auth != null && auth.uid === $uid && root.child('payments').child($uid).child('paid').val() === true && root.child('b2b_access').child($uid).child('surveySid').val() !== $sid && root.child('responses').child($uid).child($sid).child('meta/source').val() !== 'b2b' && data.child('report/_participation/source').val() !== 'b2b' && newData.child('report/_participation/source').val() !== 'b2b'",
          ".validate": "!data.exists() || !data.child('editCount').exists() || data.child('editCount').val() < 999",

          "sid": {
            ".validate": "newData.isString() && newData.val().length <= 80 && (!data.exists() || data.val() === newData.val())"
          },
          "generatedAt": {
            ".validate": "(newData.isNumber() || newData.isString()) && (!data.exists() || data.val() === newData.val())"
          },
          "engineVersion": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "rulesVersion": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "toneKey": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "signatureShort": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200)"
          },
          "pdfFilename": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "manualReportStatus": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "manualOverrideHtml": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200000)"
          },
          "editCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && (!data.exists() || newData.val() >= data.val())"
          },
          "lastEditedAt": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "lang": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 8)"
          },
          "_v4ApplyError": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 500)"
          },
          "_v4Applied": {
            ".validate": "newData.val() === null || newData.isBoolean()"
          },
          "report": {},
          "$other": { ".validate": false }
        }
      }
    },

    "programs": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "$sid": {
          ".validate": "!data.exists() || !data.child('editCount').exists() || data.child('editCount').val() < 999",

          "sid": {
            ".validate": "newData.isString() && newData.val().length <= 80 && (!data.exists() || data.val() === newData.val())"
          },
          "sourceSid": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80 && (!data.exists() || data.val() === newData.val()))"
          },
          "generatedAt": {
            ".validate": "(newData.isNumber() || newData.isString()) && (!data.exists() || data.val() === newData.val())"
          },
          "engineVersion": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "rulesVersion": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "toneKey": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "name": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
          },
          "manualProgramStatus": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 20)"
          },
          "manualOverrideHtml": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 200000)"
          },
          "editCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && (!data.exists() || newData.val() >= data.val())"
          },
          "lastEditedAt": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
          },
          "lang": {
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 8)"
          },
          "program": {},
          "$other": { ".validate": false }
        }
      }
    },

    "config": {
      ".read": "auth != null",
      ".write": false
    },

    "reviews_published": {
      ".read": true,
      ".write": false,
      ".indexOn": ["order"],
      "$pushId": {
        "text":     { ".validate": "newData.isString() && newData.val().length <= 200" },
        "initial":  { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 12)" },
        "toneKey":  { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)" },
        "lang":     { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 8)" },
        "order":    { ".validate": "newData.isNumber()" },
        "publishedAt": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 40)" },
        "$other":   { ".validate": false }
      }
    },

    "reviews": {
      "$pushId": {
        ".read": "data.child('status').val() === 'approved' || (auth != null && data.child('uid').val() === auth.uid)",

        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && root.child('reports').child(auth.uid).hasChildren()) || (data.exists() && data.child('uid').val() === auth.uid && newData.exists() === false) || (data.exists() && data.child('uid').val() === auth.uid && data.child('status').val() === 'pending' && newData.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending'))",

        ".validate": "newData.hasChildren(['uid','text','status','createdAt'])",

        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid && (!data.exists() || data.val() === newData.val())"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "initial": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 12)"
        },
        "consent": {
          ".validate": "newData.isBoolean() && newData.val() === true"
        },
        "status": {
          ".validate": "newData.isString() && newData.val() === 'pending'"
        },
        "createdAt": {
          ".validate": "(newData.isNumber() || (newData.isString() && newData.val().length <= 40)) && (!data.exists() || data.val() === newData.val())"
        },
        "updatedAt": {
          ".validate": "newData.val() === null || newData.isNumber() || (newData.isString() && newData.val().length <= 40)"
        },
        "toneKey": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
        },
        "sid": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 80)"
        },
        "lang": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 8)"
        },
        "$other": { ".validate": false }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
