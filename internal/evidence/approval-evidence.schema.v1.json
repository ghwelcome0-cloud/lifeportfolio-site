{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "evidence_id", "source_type", "source_id", "source_link", "source_content_sha256", "actor_id", "actor_role", "decision", "decided_at", "reviewed_head_sha", "pull_request", "migration_id"],
  "properties": {
    "schema_version": { "const": "internal-evidence-approval.v1" },
    "evidence_id": { "type": "string", "pattern": "^IE-APPROVAL-[0-9]{3}$" },
    "source_type": { "enum": ["github_pull_request_review", "immutable_message"] },
    "source_id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,120}$" },
    "source_link": { "type": "string", "pattern": "^https://" },
    "source_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "actor_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,80}$" },
    "actor_role": { "enum": ["owner", "independent_reviewer"] },
    "decision": { "const": "Approved" },
    "decided_at": { "type": "string", "format": "date-time" },
    "reviewed_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pull_request": { "type": "integer", "minimum": 1 },
    "migration_id": { "type": "string", "pattern": "^IE-MIG-[0-9]{3}$" }
  },
  "additionalProperties": false
}
