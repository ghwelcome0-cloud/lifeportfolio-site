{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "migration_id", "migration_kind", "from_contract_version", "to_contract_version", "from_registry_digest", "to_registry_digest", "base_main_sha", "target_main_sha", "pull_request", "reviewed_head_sha", "owner_evidence_id", "reviewer_evidence_id", "reuse_prohibited"],
  "properties": {
    "schema_version": { "const": "internal-evidence-migration.v1" },
    "migration_id": { "type": "string", "pattern": "^IE-MIG-[0-9]{3}$" },
    "migration_kind": { "enum": ["metadata_patch", "corpus_minor"] },
    "from_contract_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "to_contract_version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "from_registry_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "to_registry_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pull_request": { "type": "integer", "minimum": 1 },
    "reviewed_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "owner_evidence_id": { "type": "string", "pattern": "^IE-APPROVAL-[0-9]{3}$" },
    "reviewer_evidence_id": { "type": "string", "pattern": "^IE-APPROVAL-[0-9]{3}$" },
    "reuse_prohibited": { "const": true }
  },
  "additionalProperties": false
}
