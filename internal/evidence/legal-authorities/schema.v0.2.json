{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeportfolio.invalid/schemas/legal-authority-registry.v0.2.json",
  "title": "LifePortfolio legal issue/source/link registry",
  "type": "object",
  "required": ["schema_version", "status", "canonical_limitation", "issues", "sources", "issue_authority_links"],
  "properties": {
    "schema_version": { "const": "legal-authority-registry.v0.2" },
    "status": { "const": "issue_index_draft" },
    "canonical_limitation": { "const": "CI passing proves structural integrity only; it cannot change approval state and does not establish processing lawfulness, legal analysis approval, counsel approval, publication approval, training approval, or deployment approval." },
    "issues": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["issue_id", "applied_fact", "conclusion", "allowed_conditions", "prohibited_conditions", "reviewer", "reviewed_at", "verified_main_sha", "next_review_at", "analysis_visibility", "legal_analysis_status", "counsel_review_status"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^LP-LGL-[0-9]{3}$" },
          "applied_fact": { "type": "string", "minLength": 1 },
          "conclusion": { "type": "string", "minLength": 1 },
          "allowed_conditions": { "type": "array", "items": { "type": "string" } },
          "prohibited_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "reviewer": { "type": ["string", "null"] },
          "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
          "verified_main_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "next_review_at": { "type": ["string", "null"], "format": "date-time" },
          "analysis_visibility": { "const": "nonpublic_internal" },
          "legal_analysis_status": { "const": "not_approved" },
          "counsel_review_status": { "enum": ["pending", "changes_requested", "reviewed_not_approved"] }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "jurisdiction", "authority_type", "name", "article", "promulgation_date", "effective_from", "effective_to", "official_url", "retrieved_at", "verification_status", "blocking_reason", "hash", "snapshot_path", "retrieval_method", "minimum_quote", "verified_by", "verified_at", "case_metadata", "source_verification_status", "publication_status", "retrieval_approved", "external_qa_approved", "training_eligibility", "training_approval", "license_review_status", "approval_actor", "approval_at", "approval_source_hash"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^LP-SRC-[0-9]{3}$" },
          "jurisdiction": { "const": "KR" },
          "authority_type": { "enum": ["statute", "enforcement_decree", "official_guidance", "official_portal", "court_decision"] },
          "name": { "type": "string", "minLength": 1 },
          "article": { "type": ["string", "null"] },
          "promulgation_date": { "type": ["string", "null"], "format": "date" },
          "effective_from": { "type": ["string", "null"], "format": "date" },
          "effective_to": { "type": ["string", "null"], "format": "date" },
          "official_url": { "type": ["string", "null"], "pattern": "^https://" },
          "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
          "verification_status": { "enum": ["unverified_placeholder", "verified"] },
          "blocking_reason": { "type": ["string", "null"] },
          "hash": {
            "type": "object", "required": ["algorithm", "value", "scope"],
            "properties": { "algorithm": { "const": "sha256" }, "value": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "scope": { "type": ["string", "null"] } },
            "additionalProperties": false
          },
          "snapshot_path": { "type": ["string", "null"] },
          "retrieval_method": { "type": ["string", "null"] },
          "minimum_quote": { "type": ["string", "null"] },
          "verified_by": { "type": ["string", "null"] },
          "verified_at": { "type": ["string", "null"], "format": "date-time" },
          "case_metadata": {
            "type": ["object", "null"],
            "required": ["court", "decision_date", "case_number", "case_name", "decision_type", "holding", "fact_pattern", "application_limit", "direct_precedent_for_service"],
            "properties": {
              "court": { "type": "string" }, "decision_date": { "type": "string", "format": "date" }, "case_number": { "type": "string" }, "case_name": { "type": "string" }, "decision_type": { "type": "string" }, "holding": { "type": "string" }, "fact_pattern": { "type": "string" }, "application_limit": { "type": "string" }, "direct_precedent_for_service": { "const": false }
            },
            "additionalProperties": false
          },
          "source_verification_status": { "enum": ["not_verified", "verified"] },
          "publication_status": { "const": "not_approved" },
          "retrieval_approved": { "const": false },
          "external_qa_approved": { "const": false },
          "training_eligibility": { "const": false },
          "training_approval": { "const": "not_approved" },
          "license_review_status": { "const": "not_reviewed" },
          "approval_actor": { "type": "null" },
          "approval_at": { "type": "null" },
          "approval_source_hash": { "type": "null" }
        },
        "additionalProperties": false
      }
    },
    "issue_authority_links": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["issue_id", "source_id", "application_scope", "limitations"],
        "properties": { "issue_id": { "type": "string", "pattern": "^LP-LGL-[0-9]{3}$" }, "source_id": { "type": "string", "pattern": "^LP-SRC-[0-9]{3}$" }, "application_scope": { "type": "string", "minLength": 1 }, "limitations": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
