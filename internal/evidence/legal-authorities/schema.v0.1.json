{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeportfolio.invalid/schemas/legal-authority-registry.v0.1.json",
  "title": "LifePortfolio legal authority registry",
  "type": "object",
  "required": ["schema_version", "status", "canonical_limitation", "authorities"],
  "properties": {
    "schema_version": { "const": "legal-authority-registry.v0.1" },
    "status": { "const": "fact_evidence_draft" },
    "canonical_limitation": { "const": "CI passing proves structural integrity only; it does not establish processing lawfulness, legal approval, counsel approval, or deployment approval." },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "authority_id", "issue", "risk_grade", "authority_type", "official_url",
          "effective_from", "effective_to", "retrieved_at", "source_hash",
          "quoted_passage", "application_scope", "limitations", "superseded_by",
          "training_eligibility", "license_review_status", "approval_status",
          "approved_by", "approved_at", "counsel_review_status"
        ],
        "properties": {
          "authority_id": { "pattern": "^LP-LGL-[0-9]{3}$" },
          "issue": { "type": "string", "minLength": 1 },
          "risk_grade": { "enum": ["CRITICAL", "CRITICAL/HIGH", "HIGH", "HIGH/CONDITIONAL"] },
          "authority_type": { "enum": ["statute", "enforcement_decree", "official_guidance", "court_decision", "official_portal"] },
          "official_url": { "type": "string", "pattern": "^https://" },
          "effective_from": { "type": ["string", "null"] },
          "effective_to": { "type": ["string", "null"] },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "source_hash": { "type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$" },
          "quoted_passage": { "type": ["string", "null"] },
          "application_scope": { "type": "string", "minLength": 1 },
          "limitations": { "type": "string", "minLength": 1 },
          "superseded_by": { "type": ["string", "null"] },
          "training_eligibility": { "const": false },
          "license_review_status": { "enum": ["not_reviewed", "review_required", "approved"] },
          "approval_status": { "const": "not_approved" },
          "approved_by": { "type": "null" },
          "approved_at": { "type": "null" },
          "counsel_review_status": { "enum": ["pending", "changes_requested", "reviewed_not_approved", "approved"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
