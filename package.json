{
  "name": "webapp",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:hosting": "node scripts/build-hosting.mjs",
    "test:hosting": "node scripts/verify-hosting-build.mjs",
    "test:hosting:determinism": "npm run build:hosting && cp dist/hosting-manifest.json /tmp/lp-hosting-manifest.json && npm run build:hosting && cmp /tmp/lp-hosting-manifest.json dist/hosting-manifest.json",
    "test:hosting:contract": "npm run test:hosting:determinism && npm run test:hosting",
    "test:hosting:links": "node scripts/check-hosting-links.mjs",
    "build:admin": "node scripts/build-admin.mjs",
    "test:admin": "node scripts/verify-admin-build.mjs",
    "test:admin:determinism": "npm run build:admin && cp dist/admin-manifest.json /tmp/lp-admin-manifest.json && npm run build:admin && cmp /tmp/lp-admin-manifest.json dist/admin-manifest.json",
    "test:admin:contract": "npm run test:admin:determinism && npm run test:admin",
    "test:determinism:random": "node scripts/gates/determinism_random_gate.js",
    "test:determinism:hash": "node scripts/gates/determinism_hash_gate.js",
    "test:gate:coverage": "node scripts/gates/gate_coverage_gate.js",
    "test:determinism": "npm run test:gate:coverage && npm run test:determinism:random && npm run test:determinism:hash",
    "test": "node scripts/test-icon-legacy-safety.mjs && node scripts/test-all.mjs",
    "test:ux": "node scripts/gates/ux_quality_gate.mjs",
    "test:ux:selftest": "node scripts/gates/ux_quality_gate.mjs --self-test",
    "test:ux:json": "node scripts/gates/ux_quality_gate.mjs --json",
    "test:security": "node scripts/gates/security_posture_gate.mjs",
    "test:security:live": "node scripts/gates/security_posture_gate.mjs --live",
    "test:security:json": "node scripts/gates/security_posture_gate.mjs --json",
    "test:quality67": "npm run test:ux && npm run test:security",
    "test:report:ch9": "node scripts/gates/report_ch9_render_gate.mjs",
    "test:report:ch9:selftest": "node scripts/gates/report_ch9_render_gate.mjs --self-test",
    "test:report:ch9:json": "node scripts/gates/report_ch9_render_gate.mjs --json",
    "test:quality:all": "npm run test:ux && npm run test:security && npm run test:report:ch9 && npm run test:gate:wiring",
    "test:gate:wiring": "node scripts/gates/gate_ci_wiring_gate.mjs",
    "test:gate:wiring:selftest": "node scripts/gates/gate_ci_wiring_gate.mjs --self-test",
    "a11y:blog": "node scripts/a11y/apply_blog_a11y.mjs",
    "a11y:blog:apply": "node scripts/a11y/apply_blog_a11y.mjs --apply",
    "a11y:blog:selftest": "node scripts/a11y/apply_blog_a11y.mjs --self-test",
    "delta": "node scripts/gates/improvement_delta_gate.mjs",
    "delta:save": "node scripts/gates/improvement_delta_gate.mjs --save-baseline",
    "delta:selftest": "node scripts/gates/improvement_delta_gate.mjs --self-test",
    "rules:matrix": "node scripts/gates/rules_guard_gate.mjs",
    "rules:matrix:selftest": "node scripts/gates/rules_guard_gate.mjs --self-test",
    "a11y:core": "node scripts/a11y/apply_core_a11y.mjs",
    "a11y:core:apply": "node scripts/a11y/apply_core_a11y.mjs --apply",
    "a11y:core:selftest": "node scripts/a11y/apply_core_a11y.mjs --self-test",
    "test:touch": "node scripts/gates/touch_target_gate.mjs",
    "test:touch:json": "node scripts/gates/touch_target_gate.mjs --json",
    "test:touch:selftest": "node scripts/gates/touch_target_gate.mjs --self-test",
    "test:cwv": "node scripts/gates/cwv_gate.mjs",
    "test:cwv:json": "node scripts/gates/cwv_gate.mjs --json",
    "test:cwv:selftest": "node scripts/gates/cwv_gate.mjs --self-test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esprima": "4.0.1",
    "firebase-tools": "15.26.0",
    "parse5": "8.0.0",
    "puppeteer": "^24.42.0"
  }
}
