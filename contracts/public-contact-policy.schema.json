{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public contact policy v1",
  "type": "object",
  "required": ["schema", "policy_version", "approval_pr", "contact_pair_sha256", "pairs"],
  "properties": {
    "schema": {"const": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "approval_pr": {"type": "integer", "minimum": 1},
    "contact_pair_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "pairs": {"type":"array","items":{"type":"object","required":["value","path"],"properties":{"value":{"type":"string","minLength":1},"path":{"type":"string","minLength":1}},"additionalProperties":false}},
    "json_scalars": {"type":"array","items":{"type":"object","required":["path","key","value"],"properties":{"path":{"enum":["assets/i18n/en.json","assets/i18n/ko.json"]},"key":{"type":"string","minLength":1},"value":{"type":"string","minLength":1}},"additionalProperties":false}},
    "approved_placeholders": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^(?:[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}|01[016789]\\-?[0-9]{3,4}\\-?[0-9]{4}|\\+[0-9]{1,3}[\\- ]?(?:[0-9][\\- ]?){7,14}[0-9])$"}}
  },
  "additionalProperties": false
}
