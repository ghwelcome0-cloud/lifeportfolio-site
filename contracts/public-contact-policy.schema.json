{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public contact policy v1",
  "type": "object",
  "required": ["schema", "policy_version", "approval_pr", "contact_pair_sha256", "pairs"],
  "properties": {
    "schema": {"const": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "approval_pr": {"type": "integer", "minimum": 1},
    "contact_pair_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "pairs": {"type":"array","items":{"type":"object","required":["value","path"],"properties":{"value":{"type":"string","minLength":1},"path":{"type":"string","minLength":1}},"additionalProperties":false}},
    "json_scalars": {"type":"array","items":{"type":"object","required":["path","key","value"],"properties":{"path":{"type":"string"},"key":{"type":"string"},"value":{"type":"string"}},"additionalProperties":false}},
    "approved_placeholders": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}
